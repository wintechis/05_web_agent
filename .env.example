# Inference backend: openai (default, API) or transformers (local Hugging Face)
INFERENCE_BACKEND=openai

OPENAI_MODEL_ID="qwen3-coder-30b-a3b-instruct"
OPENAI_API_KEY=<your-api-key>
OPENAI_BASE_URL=<your-base-url>

# For INFERENCE_BACKEND=transformers: use a Hugging Face model id in OPENAI_MODEL_ID
# (same var so Hydra model config works). Optional:
# HF_DEVICE=cuda
# HF_MAX_NEW_TOKENS=4096
# TRUST_REMOTE_CODE=true
# HF_TORCH_DTYPE=bfloat16

# Determinism: lower temperature and fixed seed make responses more reproducible (optional)
OPENAI_TEMPERATURE=0
OPENAI_TOP_P=1
OPENAI_SEED=42


# Resource transformation (GET tool)
MODIFY_CONTEXT="true"
REPRESENTATION_FORMAT=wikitext
CONTEXT=modified
RDF_REPRESENTATION=html
PRUNING_METHOD=unpruned
TEXTUALIZATION=markdown
# Context compression (truncate tool messages when over token threshold)
CONTEXT_COMPRESSION=True
MAX_TOKEN_FOR_MODEL=120000
# COMPRESSION_STRATEGY: truncate (default) | recency_uri | tiered
COMPRESSION_STRATEGY=truncate
# COMPRESSION_KEEP_FULL_LAST_N: used by recency_uri strategy (default 2)
COMPRESSION_KEEP_FULL_LAST_N=2

# Agent reasoning / answer validation (all default to false)
SCRATCHPAD_MODE=false
THINKING_MODE=false
PLAN_MODE=false
PATH_VALIDATION=false