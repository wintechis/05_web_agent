OPENAI_MODEL_ID="qwen3-coder-30b-a3b-instruct"
OPENAI_API_KEY=<your-api-key>
OPENAI_BASE_URL=<your-base-url>

# Determinism: lower temperature and fixed seed make responses more reproducible (optional)
OPENAI_TEMPERATURE=0
OPENAI_TOP_P=1
OPENAI_SEED=42


# Resource transformation (GET tool)
MODIFY_CONTEXT="true"
REPRESENTATION_FORMAT=wikitext
CONTEXT=modified
RDF_REPRESENTATION=html
PRUNING_METHOD=unpruned
TEXTUALIZATION=markdown
# Context compression (truncate tool messages when over token threshold)
CONTEXT_COMPRESSION=True
MAX_TOKEN_FOR_MODEL=120000